{
  "name": "pi-forget",
  "version": "0.1.0",
  "type": "module",
  "description": "A pi extension for reversible synthetic-branch context forgetting.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mteam88/pi-forget.git"
  },
  "keywords": ["pi-package", "pi", "extension", "context"],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx test/projector.test.ts",
    "test:rpc:smoke": "tsx test/rpc-smoke.ts",
    "test:rpc:provider": "tsx test/rpc-forget-provider.ts",
    "test:rpc": "npm run test:rpc:smoke && npm run test:rpc:provider",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "latest",
    "@mariozechner/pi-agent-core": "latest",
    "@mariozechner/pi-coding-agent": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typebox": "latest",
    "typescript": "latest"
  }
}
